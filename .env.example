# Copy to .env and fill in your values.
# docker compose reads this file automatically.
#
# costblame acts on whichever variables are filled in — every integration
# is optional and auto-detected. Leave anything you don't use blank.

# ── Web UI / REST API access ─────────────────────────────────────────────
# Bearer token, or the password in HTTP Basic auth (any username). If blank,
# a temporary token is generated at startup and printed in the logs.
COSTBLAME_SERVER_API_TOKEN=

# ── Cloud billing (built-in adapter: AWS Cost Explorer) ──────────────────
# Prefer an IAM role / instance profile in production over static keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=        # optional — only needed for assumed roles

# ── LLM narratives (optional — template narratives without one) ──────────
# Set whichever matches your provider; costblame auto-detects it.
ANTHROPIC_API_KEY=        # Anthropic API
OPENAI_API_KEY=           # OpenAI or any OpenAI-compatible host
OPENAI_BASE_URL=          # custom/compatible endpoint (Groq, Mistral, vLLM, …)
OLLAMA_HOST=              # local Ollama, e.g. http://localhost:11434
COSTBLAME_LLM_MODEL=      # override the provider's default model

# ── CI/CD deploy sources (filling one in enables it) ─────────────────────
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=             # optional — enables PR metadata enrichment
COSTBLAME_SOURCES_GITHUB_DEPLOY_WORKFLOWS=   # e.g. Deploy,release.yml — which workflows are deploys
GITLAB_WEBHOOK_SECRET=
COSTBLAME_SOURCES_ARGOCD_ENABLED=   # set to true to enable the ArgoCD receiver
ARGOCD_WEBHOOK_TOKEN=               # required with ArgoCD: sent as "Authorization: Bearer <token>"

# ── Alerts (filling one in enables it) ───────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_CHANNEL=            # channel ID, not name
COSTBLAME_NOTIFY_WEBHOOK_URL=       # generic outbound webhook for anything else

# ── Dev tooling ──────────────────────────────────────────────────────────
NGROK_AUTHTOKEN=          # only needed when running the dev profile

# Host port for the combined webhook + REST API server (change if taken)
COSTBLAME_PORT=7890
